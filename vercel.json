{
  "buildCommand": "npm run build",
  "functions": {
    "api/install-schema.ts": {
      "includeFiles": "supabase/schema.sql"
    }
  },
  "rewrites": [
    { "source": "/api/plugins/:path*", "destination": "/api/plugins?__path=:path*" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
